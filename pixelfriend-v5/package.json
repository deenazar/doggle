{
  "name": "pixelfriend",
  "version": "1.0.0",
  "description": "A tiny pixel desktop buddy that reminds you to drink water.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pixelfriend.app",
    "productName": "PixelFriend",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
